            if (currentFile === "quadratic_solver.py") {
                codeEditor.value = virtualFiles["quadratic_solver.py"].content;
                updateLineNumbers();
            } else {
                switchTab("quadratic_solver.py");
            }

            // Chạy Python ngay lập tức
            runPythonCode();
        }

        btnApplyQuick.addEventListener('click', () => {
            const a = parseFloat(quickA.value) || 0;
            const b = parseFloat(quickB.value) || 0;
            const c = parseFloat(quickC.value) || 0;
            updateCodeAndSolve(a, b, c);
        });

        presetSelector.addEventListener('change', (e) => {
            const [a, b, c] = e.target.value.split(',');
            quickA.value = a;
            quickB.value = b;
            quickC.value = c;
            updateCodeAndSolve(a, b, c);
        });

        // Resizable panel splitter
        const resizer = document.getElementById('panel-resizer');
        let isResizing = false;
        resizer.addEventListener('mousedown', () => {
            isResizing = true;
            document.body.style.cursor = 'row-resize';
        });
        window.addEventListener('mousemove', (e) => {
            if (!isResizing) return;
            const containerHeight = window.innerHeight;
            const newHeight = containerHeight - e.clientY - 24;
            if (newHeight >= 80 && newHeight <= containerHeight * 0.85) {
                terminalPanel.style.height = `${newHeight}px`;
            }
        });
        window.addEventListener('mouseup', () => {
            isResizing = false;
            document.body.style.cursor = 'default';
        });

        // Khởi động khi tải xong trang
        window.onload = function() {
            codeEditor.value = virtualFiles[currentFile].content;
            renderTabs();
            updateLineNumbers();
            initPyodideWasm();
        };
    </script>
</body>
</html>
