    <script>
        // DOM Token List Safe Helpers (Chống dứt điểm lỗi InvalidCharacterError)
        function safeClassRemove(element, ...classStrings) {
            if (!element) return;
            classStrings.forEach(str => {
                if (!str) return;
                // Tách theo khoảng trắng hoặc dấu phẩy để biến thành danh sách token hợp lệ
                const tokens = str.split(/[\s,]+/);
                tokens.forEach(token => {
                    const cleanToken = token.trim();
                    if (cleanToken) {
                        element.classList.remove(cleanToken);
                    }
                });
            });
        }

        function safeClassAdd(element, ...classStrings) {
            if (!element) return;
            classStrings.forEach(str => {
                if (!str) return;
                const tokens = str.split(/[\s,]+/);
                tokens.forEach(token => {
                    const cleanToken = token.trim();
                    if (cleanToken) {
                        element.classList.add(cleanToken);
                    }
                });
            });
        }

        // Virtual Filesystem & Workspace Data
        const virtualFiles = {
            "quadratic_solver.py": {
                name: "quadratic_solver.py",
                icon: "fa-brands fa-python text-[#4b8bbe]",
                content: `"""
MÔ HÌNH HÀM SỐ BẬC HAI & BỘ GIẢI ỔN ĐỊNH SỐ HỌC
Chuẩn: IEEE 754 Floating-Point Arithmetic
"""
import math
from enum import Enum
from dataclasses import dataclass
from typing import Tuple, Optional

class RootType(Enum):
    TWO_REAL = "Hai nghiệm thực phân biệt"
    ONE_REAL = "Nghiệm kép thực"
    NO_REAL = "Vô nghiệm thực (Có 2 nghiệm phức)"
    LINEAR_ONE = "Suy biến: Bậc nhất 1 nghiệm"
    NO_SOLUTION = "Suy biến: Vô nghiệm (0x + c = 0)"
    INFINITE_SOLUTIONS = "Suy biến: Vô số nghiệm (0 = 0)"

@dataclass
class QuadResult:
    status: RootType
    roots: Tuple[Optional[float], Optional[float]] = (None, None)
    complex_roots: Tuple[Optional[complex], Optional[complex]] = (None, None)
    delta: Optional[float] = None
    note: str = ""

class QuadraticEquation:
    """
    Đại diện hàm số f(x) = ax^2 + bx + c.
    Tích hợp thuật toán Horner và công thức nghiệm ổn định.
    """
    def __init__(self, a: float, b: float, c: float):
        for name, val in [('a', a), ('b', b), ('c', c)]:
            if not isinstance(val, (int, float)):
                raise TypeError(f"Hệ số '{name}' phải là kiểu số, nhận: {type(val).__name__}")
            if not math.isfinite(val):
                raise ValueError(f"Hệ số '{name}' phải hữu hạn (không NaN/Inf).")

        self.orig_a = float(a)
        self.orig_b = float(b)
        self.orig_c = float(c)

        # Chuẩn hóa hệ số để tránh tràn số (Overflow) khi tính Delta
        max_coeff = max(abs(self.orig_a), abs(self.orig_b), abs(self.orig_c))
        if max_coeff == 0:
            self.a, self.b, self.c = 0.0, 0.0, 0.0
        else:
            self.a = self.orig_a / max_coeff
            self.b = self.orig_b / max_coeff
            self.c = self.orig_c / max_coeff

    def __str__(self) -> str:
        """Định dạng chuỗi toán học động cho phương trình."""
        parts = []
        if self.orig_a != 0:
            if self.orig_a == 1:
                parts.append("x²")
            elif self.orig_a == -1:
                parts.append("-x²")
            else:
                parts.append(f"{self.orig_a:g}x²")
        if self.orig_b != 0:
            if parts:
                sign = " + " if self.orig_b > 0 else " - "
                abs_b = abs(self.orig_b)
                coeff = "" if abs_b == 1 else f"{abs_b:g}"
                parts.append(f"{sign}{coeff}x")
            else:
                coeff = "" if self.orig_b == 1 else ("-" if self.orig_b == -1 else f"{self.orig_b:g}")
                parts.append(f"{coeff}x")
        if self.orig_c != 0:
            if parts:
                sign = " + " if self.orig_c > 0 else " - "
                parts.append(f"{sign}{abs(self.orig_c):g}")
            else:
                parts.append(f"{self.orig_c:g}")
        if not parts:
            parts.append("0")
        return "".join(parts) + " = 0"

    def evaluate(self, x: float) -> float:
        """Tính f(x) dùng sơ đồ Horner: ((a*x) + b)*x + c"""
        if not math.isfinite(x):
            raise ValueError("x phải hữu hạn.")
        return (self.orig_a * x + self.orig_b) * x + self.orig_c

    def get_vertex(self) -> Tuple[float, float]:
        """Tọa độ đỉnh (x_v, y_v). Dùng Horner thay vì -Delta/4a để tránh mất độ chính xác."""
        if self.orig_a == 0:
            raise ArithmeticError("a = 0: Hàm suy biến bậc nhất, không có đỉnh Parabol.")
        x_v = -self.orig_b / (2.0 * self.orig_a)
        y_v = self.evaluate(x_v)
        return (x_v, y_v)

    def solve(self, rel_tol: float = 1e-12, abs_tol: float = 1e-14) -> QuadResult:
        """Giải phương trình ax^2 + bx + c = 0 bằng thuật toán số học ổn định."""
        if self.a == 0.0:
            if self.b == 0.0:
                if self.c == 0.0:
                    return QuadResult(RootType.INFINITE_SOLUTIONS, note="Thỏa mãn với mọi x")
                return QuadResult(RootType.NO_SOLUTION, note="Vô nghiệm")
            root = -self.orig_c / self.orig_b
            return QuadResult(RootType.LINEAR_ONE, (root, None), note="Phương trình bậc nhất")

        if self.c == 0.0:
            x1, x2 = 0.0, -self.orig_b / self.orig_a
            r_min, r_max = min(x1, x2), max(x1, x2)
            if math.isclose(r_min, r_max, rel_tol=rel_tol, abs_tol=abs_tol):
                return QuadResult(RootType.ONE_REAL, (0.0, 0.0), delta=0.0)
            return QuadResult(RootType.TWO_REAL, (r_min, r_max), delta=self.b*self.b)

        delta = self.b * self.b - 4.0 * self.a * self.c

        if math.isclose(delta, 0.0, rel_tol=rel_tol, abs_tol=abs_tol) or delta == 0.0:
            x_k = -self.orig_b / (2.0 * self.orig_a)
            return QuadResult(RootType.ONE_REAL, (x_k, x_k), delta=0.0)

        if delta < 0.0:
            real_part = -self.orig_b / (2.0 * self.orig_a)
            orig_delta = self.orig_b * self.orig_b - 4.0 * self.orig_a * self.orig_c
